From 27fd27461a8d558dd7c579558b1c0ea49f7192ff Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Sun, 1 Nov 2026 09:13:27 +0000
Subject: [PATCH] perf: lahaina: Use the 6.12 bus nodes on yupik

redwood runs Qualcomm's 6.12 kernel, where DDR, L3 and LLCC are scaled
by bus_dcvs. The yupik configs still named the 5.4 devfreq and memlat
nodes, so the DDR and L3 parts of the launch and frame boosts failed
on every request ("Failed to apply optimization [12, 4]").

Point yupik at the bus_dcvs nodes the way Qualcomm's 6.x targets (kalama,
pineapple, parrot) do: the new LLCC_DDR_BW opcodes on the DDR bwmon, with
min_freq in kHz, and only the L3 memlat ceilings, since memlat scales
the L3 floor itself. The launch boost now holds DDR at 2092 MHz and the
120/144 fps boosts at 451 MHz, the frequencies the old bandwidth values
stood for.
---
 .../configs/lahaina/perf/perfboostsconfig.xml |  6 ++--
 .../lahaina/perf/targetresourceconfigs.xml    | 29 +++++++++++++++----
 2 files changed, 26 insertions(+), 9 deletions(-)

diff --git a/vendor/perf/configs/lahaina/perf/perfboostsconfig.xml b/vendor/perf/configs/lahaina/perf/perfboostsconfig.xml
index 974588f4..a587a604 100644
--- a/vendor/perf/configs/lahaina/perf/perfboostsconfig.xml
+++ b/vendor/perf/configs/lahaina/perf/perfboostsconfig.xml
@@ -61,7 +61,7 @@
            Id="0x00001081" Type="1" Enable="true" Timeout="2000" Target="yupik"
            Resources="0x40C00000, 0x1, 0x40804000, 0xFFF, 0x40804100, 0xFFF, 0x40804200, 0xFFF,
                       0x40800000, 0xFFF, 0x40800100, 0xFFF, 0x40800200, 0xFFF,
-                      0x43018000, 0xFF, 0x43010000, 0xFF, 0x40400000, 0x1, 0x42C10000, 0x1,
+                      0x4303C000, 2092000, 0x40400000, 0x1, 0x42C10000, 0x1,
                       0x43430100, 0x1FC8, 0x43430000, 0x1FC8, 0x43400000, 0xFFFF" />
 
     <!--app lauch boost (disabling packing)-->
@@ -679,12 +679,12 @@
          <Config
              Id="0x00001087" Type="1" Enable="true" Timeout="0" Target="yupik" Fps="120"
              Resources="0x40800000, 1228, 0x40800100, 1152, 0x40800200, 1056, 0x40C00000, 2,
-                        0x43010000, 0x11, 0x43400000, 0x1F40" />
+                        0x4303C000, 451000, 0x43400000, 0x1F40" />
 
          <Config
              Id="0x00001087" Type="1" Enable="true" Timeout="0" Target="yupik" Fps="144"
              Resources="0x40800000, 1228, 0x40800100, 1152, 0x40800200, 1056, 0x40C00000, 2,
-                        0x43010000, 0x11, 0x43400000, 0x2AF8" />
+                        0x4303C000, 451000, 0x43400000, 0x2AF8" />
 
     <!--PackageInstall boost-->
         <!-- SCHEDBOOST resource opcode, value-->
diff --git a/vendor/perf/configs/lahaina/perf/targetresourceconfigs.xml b/vendor/perf/configs/lahaina/perf/targetresourceconfigs.xml
index 1dfd25ed..96b40056 100644
--- a/vendor/perf/configs/lahaina/perf/targetresourceconfigs.xml
+++ b/vendor/perf/configs/lahaina/perf/targetresourceconfigs.xml
@@ -102,6 +102,19 @@ as anyway perflock calls of these resources would fail. -->
         <Config MajorValue="0xC" MinorValue="0x3" Supported="no" Target="yupik" />
         <Config MajorValue="0xC" MinorValue="0xA" Supported="no" Target="yupik" /> <!-- cpubw_hmon_low_power_ceil_mbps -->
         <Config MajorValue="0xC" MinorValue="0xB" Supported="no" Target="yupik" /> <!-- cpubw_hmon_low_power_io_percent -->
+        <!-- redwood: the 6.12 kernel's DDR bwmon sits under bus_dcvs. The old
+             LLCC_DDR_BW opcodes name 5.4 devfreq nodes, so use the new ones
+             there, as Qualcomm's 6.x targets do; min_freq takes kHz -->
+        <Config MajorValue="0xC" MinorValue="0x4" Supported="no" Target="yupik" />
+        <Config MajorValue="0xC" MinorValue="0x5" Node="/sys/devices/system/cpu/bus_dcvs/DDR/9091000.qcom,bwmon-ddr/up_scale" Target="yupik" />
+        <Config MajorValue="0xC" MinorValue="0x6" Supported="no" Target="yupik" />
+        <Config MajorValue="0xC" MinorValue="0x7" Node="/sys/devices/system/cpu/bus_dcvs/DDR/9091000.qcom,bwmon-ddr/decay_rate" Target="yupik" />
+        <Config MajorValue="0xC" MinorValue="0x8" Node="/sys/devices/system/cpu/bus_dcvs/DDR/9091000.qcom,bwmon-ddr/io_percent" Target="yupik" />
+        <Config MajorValue="0xC" MinorValue="0x9" Node="/sys/devices/system/cpu/bus_dcvs/DDR/9091000.qcom,bwmon-ddr" Target="yupik" />
+        <Config MajorValue="0xC" MinorValue="0xC" Node="/sys/devices/system/cpu/bus_dcvs/DDR/9091000.qcom,bwmon-ddr/window_ms" Target="yupik" />
+        <Config MajorValue="0xC" MinorValue="0xD" Node="/sys/devices/system/cpu/bus_dcvs/DDR/9091000.qcom,bwmon-ddr/sample_ms" Target="yupik" />
+        <Config MajorValue="0xC" MinorValue="0xE" Node="/sys/devices/system/cpu/bus_dcvs/DDR/9091000.qcom,bwmon-ddr/idle_mbps" Target="yupik" />
+        <Config MajorValue="0xC" MinorValue="0xF" Node="/sys/devices/system/cpu/bus_dcvs/DDR/9091000.qcom,bwmon-ddr/min_freq" Target="yupik" />
 
         <Config MajorValue="0xD" MinorValue="0x0" Node="/sys/class/devfreq/18590100.qcom,cpu%d-cpu-l3-lat/min_freq" />
         <Config MajorValue="0xD" MinorValue="0x1" Node="/sys/class/devfreq/18590100.qcom,cpu0-cpu-l3-lat/mem_latency/ratio_ceil" />
@@ -109,12 +122,16 @@ as anyway perflock calls of these resources would fail. -->
         <Config MajorValue="0xD" MinorValue="0x3" Node="/sys/class/devfreq/18590100.qcom,cpu0-cpu-l3-lat/mem_latency/stall_floor" />
         <Config MajorValue="0xD" MinorValue="0x4" Node="/sys/class/devfreq/18590100.qcom,cpu4-cpu-l3-lat/mem_latency/stall_floor" />
         <Config MajorValue="0xD" MinorValue="0x11" Node="/sys/class/devfreq/18590100.qcom,cpu%d-cpu-l3-lat/max_freq" />
-        <Config MajorValue="0xD" MinorValue="0x0" Node="/sys/devices/system/cpu/memlat/c%d_memlat/cpu%d-cpu-l3-lat/min_freq" Target="yupik"/>
-        <Config MajorValue="0xD" MinorValue="0x1" Node="/sys/devices/system/cpu/memlat/c0_memlat/cpu0-cpu-l3-lat/ratio_ceil" Target="yupik" />
-        <Config MajorValue="0xD" MinorValue="0x2" Node="/sys/devices/system/cpu/memlat/c4_memlat/cpu4-cpu-l3-lat/ratio_ceil" Target="yupik" />
-        <Config MajorValue="0xD" MinorValue="0x3" Node="/sys/devices/system/cpu/memlat/c0_memlat/cpu0-cpu-l3-lat/stall_floor" Target="yupik" />
-        <Config MajorValue="0xD" MinorValue="0x4" Node="/sys/devices/system/cpu/memlat/c4_memlat/cpu4-cpu-l3-lat/stall_floor" Target="yupik" />
-        <Config MajorValue="0xD" MinorValue="0x11" Node="/sys/devices/system/cpu/memlat/c%d_memlat/cpu%d-cpu-l3-lat/max_freq" Target="yupik" />
+<!-- redwood: on the 6.12 kernel L3 has memlat under bus_dcvs, which scales
+             its minimum itself; boost only its ceilings, as Qualcomm's 6.x
+             targets do -->
+        <Config MajorValue="0xD" MinorValue="0x0" Supported="no" Target="yupik" />
+        <Config MajorValue="0xD" MinorValue="0x1" Node="/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:silver/ipm_ceil" Target="yupik" />
+        <Config MajorValue="0xD" MinorValue="0x2" Node="/sys/devices/system/cpu/bus_dcvs/L3/soc:qcom,memlat:l3:gold/ipm_ceil" Target="yupik" />
+        <Config MajorValue="0xD" MinorValue="0x3" Supported="no" Target="yupik" />
+        <Config MajorValue="0xD" MinorValue="0x4" Supported="no" Target="yupik" />
+        <Config MajorValue="0xD" MinorValue="0xC" Supported="no" Target="yupik" />
+        <Config MajorValue="0xD" MinorValue="0x11" Supported="no" Target="yupik" />
         <Config MajorValue="0xD" MinorValue="0x5" Supported="no" Target="shima" />
         <Config MajorValue="0xD" MinorValue="0x6" Supported="no" Target="shima" />
         <Config MajorValue="0xD" MinorValue="0x5" Supported="no" Target="yupik" />
-- 
2.43.0

