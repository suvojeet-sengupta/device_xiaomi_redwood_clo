From dfb1524d62f5a7eb11369b57aa1e16d897732e29 Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Sat, 17 Oct 2026 08:49:16 +0530
Subject: [PATCH] WallpaperManager: Optionally cap how much larger the crop is
 than the display

The cropped bitmap is only downsampled as far as the orientation that
needs the most pixels allows. For a tall image, the landscape crop keeps
it more than twice the display's size in portrait, and SurfaceFlinger
has to scale it down on every frame that shows the wallpaper.

Display hardware with a single scaling pipe, like the yupik DPU, can't
fetch that within its per-pipe bandwidth limit or split it across
pipes, so it composes the whole display on the GPU whenever the
wallpaper is visible and anything moves. The app drawer and home screen
then drop frames at 120Hz.

Add an overlayable config that downsamples further until no orientation
is more than the given factor larger than its display. It defaults to 0,
which keeps the current behaviour.
---
 core/res/res/values/wallpaper_config.xml      | 10 ++++++++++
 .../server/wallpaper/WallpaperCropper.java    | 20 +++++++++++++++++++
 .../wallpaper/WallpaperManagerService.java    |  3 ++-
 3 files changed, 32 insertions(+), 1 deletion(-)
 create mode 100644 core/res/res/values/wallpaper_config.xml

diff --git a/core/res/res/values/wallpaper_config.xml b/core/res/res/values/wallpaper_config.xml
new file mode 100644
index 0000000..c4141b1
--- /dev/null
+++ b/core/res/res/values/wallpaper_config.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- The most a cropped static wallpaper may be larger than the display, for any
+         orientation. The bitmap is kept large enough for every orientation's crop, which
+         can leave it twice the display or more in portrait; display hardware that can't
+         downscale that much falls back to GPU composition whenever the wallpaper shows.
+         0 means no limit. -->
+    <item name="config_wallpaperMaxDisplayDownscale" format="float" type="dimen">0</item>
+    <java-symbol type="dimen" name="config_wallpaperMaxDisplayDownscale" />
+</resources>
diff --git a/services/core/java/com/android/server/wallpaper/WallpaperCropper.java b/services/core/java/com/android/server/wallpaper/WallpaperCropper.java
index 77b814b..0406ce6 100644
--- a/services/core/java/com/android/server/wallpaper/WallpaperCropper.java
+++ b/services/core/java/com/android/server/wallpaper/WallpaperCropper.java
@@ -95,9 +95,20 @@ public class WallpaperCropper {
 
     private final WallpaperDefaultDisplayInfo mDefaultDisplayInfo;
 
+    /**
+     * How much larger than a display the cropped bitmap may be for any orientation, or 0 for
+     * no limit. See config_wallpaperMaxDisplayDownscale.
+     */
+    private final float mMaxDisplayDownscale;
+
     WallpaperCropper(WallpaperDisplayHelper wallpaperDisplayHelper) {
+        this(wallpaperDisplayHelper, 0f);
+    }
+
+    WallpaperCropper(WallpaperDisplayHelper wallpaperDisplayHelper, float maxDisplayDownscale) {
         mWallpaperDisplayHelper = wallpaperDisplayHelper;
         mDefaultDisplayInfo = mWallpaperDisplayHelper.getDefaultDisplayInfo();
+        mMaxDisplayDownscale = maxDisplayDownscale;
     }
 
     /**
@@ -654,6 +665,7 @@ public class WallpaperCropper {
                     || cropHint.width() > GLHelper.getMaxTextureSize();
 
             float sampleSize = Float.MAX_VALUE;
+            float maxSampleSize = 1f;
             // If all crops for all orientations have more width and height in pixel
             // than the display for this orientation, downsample the image
             for (int i = 0; i < defaultCrops.size(); i++) {
@@ -666,6 +678,14 @@ public class WallpaperCropper {
                         (float) crop.width() / displayForThisOrientation.x,
                         (float) crop.height() / displayForThisOrientation.y));
                 sampleSize = Math.min(sampleSize, sampleSizeForThisOrientation);
+                maxSampleSize = Math.max(maxSampleSize, sampleSizeForThisOrientation);
+            }
+            // A bitmap kept large enough for the landscape crop can be more than twice the
+            // display in portrait. If the display hardware can't downscale that much, every
+            // frame that shows the wallpaper falls back to GPU composition, so downsample
+            // until no orientation is more than mMaxDisplayDownscale times its display.
+            if (mMaxDisplayDownscale >= 1f) {
+                sampleSize = Math.max(sampleSize, maxSampleSize / mMaxDisplayDownscale);
             }
             // If the total crop has more width or height than either the max texture size
             // or twice the largest display dimension, downsample the image
diff --git a/services/core/java/com/android/server/wallpaper/WallpaperManagerService.java b/services/core/java/com/android/server/wallpaper/WallpaperManagerService.java
index 27e26df..f8b8481 100644
--- a/services/core/java/com/android/server/wallpaper/WallpaperManagerService.java
+++ b/services/core/java/com/android/server/wallpaper/WallpaperManagerService.java
@@ -1522,7 +1522,8 @@ public class WallpaperManagerService extends IWallpaperManager.Stub
         WindowManager windowManager = mContext.getSystemService(WindowManager.class);
         mWallpaperDisplayHelper = new WallpaperDisplayHelper(
                 displayManager, windowManager, mWindowManagerInternal, mContext.getResources());
-        mWallpaperCropper = new WallpaperCropper(mWallpaperDisplayHelper);
+        mWallpaperCropper = new WallpaperCropper(mWallpaperDisplayHelper,
+                mContext.getResources().getFloat(R.dimen.config_wallpaperMaxDisplayDownscale));
         mActivityManager = mContext.getSystemService(ActivityManager.class);
 
         if (mContext.getResources().getBoolean(
