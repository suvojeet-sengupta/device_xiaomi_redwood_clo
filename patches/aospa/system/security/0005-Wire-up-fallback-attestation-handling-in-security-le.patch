+static DEFAULT_CERT_SUBJECT_DER: &[u8] = &[
+    // Name ::= SEQUENCE { RDNSequence }, CN=Android Keystore Key
+    0x30, 0x1f, 0x31, 0x1d, 0x30, 0x1b, 0x06, 0x03, 0x55, 0x04, 0x03, 0x0c, 0x14, 0x41, 0x6e,
