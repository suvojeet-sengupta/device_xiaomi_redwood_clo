From 82e4ddebd99513a5d7628f4e9c762386fac8f07e Mon Sep 17 00:00:00 2001
From: kenway214 <kenway214@outlook.com>
Date: Fri, 11 Sep 2026 18:33:59 +0000
Subject: [PATCH 2/2] vendor: Add keystore compatibility init script

Change-Id: Ia128bc0e89b39e612c609a2063f03e76d2cdab9e
---
 target/init/keystore-compat.rc | 4 ++++
 target/product/aospa-target.mk | 4 ++++
 2 files changed, 8 insertions(+)
 create mode 100644 target/init/keystore-compat.rc

diff --git a/target/init/keystore-compat.rc b/target/init/keystore-compat.rc
new file mode 100644
index 0000000..8cef38b
--- /dev/null
+++ b/target/init/keystore-compat.rc
@@ -0,0 +1,4 @@
+on post-fs-data
+    # Keystore compatibility runtime
+    mkdir /data/system/keystore_compat 0775 system system
+    restorecon_recursive /data/system/keystore_compat
diff --git a/target/product/aospa-target.mk b/target/product/aospa-target.mk
index 41af062..cfda249 100644
--- a/target/product/aospa-target.mk
+++ b/target/product/aospa-target.mk
@@ -262,3 +262,7 @@ PRODUCT_PACKAGES += \
     libwpa_client
 
 PRODUCT_VENDOR_MOVE_ENABLED := true
+
+# Keystore Compatibility
+PRODUCT_COPY_FILES += \
+    vendor/aospa/target/init/keystore-compat.rc:$(TARGET_COPY_OUT_SYSTEM)/etc/init/keystore-compat.rc
-- 
2.43.0

