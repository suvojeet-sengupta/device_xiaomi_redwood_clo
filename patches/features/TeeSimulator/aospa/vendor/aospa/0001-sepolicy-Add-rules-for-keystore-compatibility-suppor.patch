From b7f7662018135605c46e9a3542226e5e6c7172e6 Mon Sep 17 00:00:00 2001
From: kenway214 <kenway214@outlook.com>
Date: Fri, 11 Sep 2026 18:33:59 +0000
Subject: [PATCH 1/2] sepolicy: Add rules for keystore compatibility support

Change-Id: I2c829f64cf2ce6b74e8256569695ce262eba9431
---
 sepolicy/private/appdomain.te      | 3 +++
 sepolicy/private/file.te           | 3 +++
 sepolicy/private/file_contexts     | 4 ++++
 sepolicy/private/gmscore_app.te    | 3 +++
 sepolicy/private/keystore.te       | 8 ++++++++
 sepolicy/private/platform_app.te   | 4 ++++
 sepolicy/private/property_contexts | 4 ++++
 sepolicy/private/system_app.te     | 4 ++++
 sepolicy/private/system_server.te  | 5 +++++
 sepolicy/public/property.te        | 2 ++
 10 files changed, 40 insertions(+)
 create mode 100644 sepolicy/private/keystore.te
 create mode 100644 sepolicy/public/property.te

diff --git a/sepolicy/private/appdomain.te b/sepolicy/private/appdomain.te
index 8a6b929..40ef5f4 100644
--- a/sepolicy/private/appdomain.te
+++ b/sepolicy/private/appdomain.te
@@ -1 +1,4 @@
 get_prop(appdomain, pih_disable_prop)
+
+# Keystore compatibility
+get_prop(appdomain, keystore_compat_prop)
diff --git a/sepolicy/private/file.te b/sepolicy/private/file.te
index 48c5be9..37e7b59 100644
--- a/sepolicy/private/file.te
+++ b/sepolicy/private/file.te
@@ -1,2 +1,5 @@
 # Pocket Judge
 type pocket_judge_sysfs, fs_type, sysfs_type;
+
+# Keystore compatibility
+type keystore_compat_data_file, file_type, data_file_type, core_data_file_type;
diff --git a/sepolicy/private/file_contexts b/sepolicy/private/file_contexts
index 15f4068..146922f 100644
--- a/sepolicy/private/file_contexts
+++ b/sepolicy/private/file_contexts
@@ -3,3 +3,7 @@
 
 # Pocket Judge
 /sys/kernel/pocket_judge(/.*)?	        u:object_r:pocket_judge_sysfs:s0
+
+# Keystore compatibility
+/data/system/keystore_compat(/.*)?          u:object_r:keystore_compat_data_file:s0
+/data/system/tee_simulator(/.*)?            u:object_r:keystore_compat_data_file:s0
diff --git a/sepolicy/private/gmscore_app.te b/sepolicy/private/gmscore_app.te
index 3d2a68c..868b691 100644
--- a/sepolicy/private/gmscore_app.te
+++ b/sepolicy/private/gmscore_app.te
@@ -1 +1,4 @@
 set_prop(gmscore_app, system_prop)
+
+# Keystore compatibility
+get_prop(gmscore_app, keystore_compat_prop)
diff --git a/sepolicy/private/keystore.te b/sepolicy/private/keystore.te
new file mode 100644
index 0000000..7d7b040
--- /dev/null
+++ b/sepolicy/private/keystore.te
@@ -0,0 +1,8 @@
+# Keystore compatibility
+allow keystore keystore_compat_data_file:dir create_dir_perms;
+allow keystore keystore_compat_data_file:file create_file_perms;
+set_prop(keystore, keystore_compat_prop)
+
+# Allow keystore to query package_native service from system_server for UID resolution
+allow keystore package_native_service:service_manager find;
+binder_call(keystore, system_server)
diff --git a/sepolicy/private/platform_app.te b/sepolicy/private/platform_app.te
index 38fa551..7b7c0bf 100644
--- a/sepolicy/private/platform_app.te
+++ b/sepolicy/private/platform_app.te
@@ -5,3 +5,7 @@ hal_client_domain(platform_app, hal_aospa_powershare)
 
 # Allow LineageHealth HAL service to be found
 hal_client_domain(platform_app, hal_lineage_health)
+
+# Keystore compatibility
+allow platform_app keystore_compat_data_file:dir create_dir_perms;
+allow platform_app keystore_compat_data_file:file create_file_perms;
diff --git a/sepolicy/private/property_contexts b/sepolicy/private/property_contexts
index 02447fb..5aa72d8 100644
--- a/sepolicy/private/property_contexts
+++ b/sepolicy/private/property_contexts
@@ -6,3 +6,7 @@ persist.sys.pihooks.disable.            u:object_r:pih_disable_prop:s0
 
 # Tethering
 persist.device_config.tethering.        u:object_r:device_config_tethering_prop:s0
+
+# Keystore compatibility
+sys.keystore_compat.                   u:object_r:keystore_compat_prop:s0
+sys.tee_simulator.                     u:object_r:keystore_compat_prop:s0
diff --git a/sepolicy/private/system_app.te b/sepolicy/private/system_app.te
index b50980b..ac91c77 100644
--- a/sepolicy/private/system_app.te
+++ b/sepolicy/private/system_app.te
@@ -1,2 +1,6 @@
 # Allow system_app to read the AOSPA version.
 get_prop(system_app, aospa_build_prop)
+
+# Keystore compatibility
+allow system_app keystore_compat_data_file:dir create_dir_perms;
+allow system_app keystore_compat_data_file:file create_file_perms;
diff --git a/sepolicy/private/system_server.te b/sepolicy/private/system_server.te
index e827571..27653ed 100644
--- a/sepolicy/private/system_server.te
+++ b/sepolicy/private/system_server.te
@@ -21,3 +21,8 @@ allow system_server zygote_tmpfs:file rw_file_perms;
 
 # PIH
 add_service(system_server, pih_manager_service);
+
+# Keystore compatibility
+allow system_server keystore_compat_data_file:dir create_dir_perms;
+allow system_server keystore_compat_data_file:file create_file_perms;
+get_prop(system_server, keystore_compat_prop)
diff --git a/sepolicy/public/property.te b/sepolicy/public/property.te
new file mode 100644
index 0000000..07f082d
--- /dev/null
+++ b/sepolicy/public/property.te
@@ -0,0 +1,2 @@
+# Keystore compatibility
+system_public_prop(keystore_compat_prop)
-- 
2.43.0

