# Platform apps targeting SDK 36 or lower, like Dolby's DaxService, run as
# platform_app_36 instead of platform_app.

# Audio
get_prop(platform_app_36, audio_config_prop)

# Dolby
hal_client_domain(platform_app_36, hal_dms)
hal_client_domain(platform_app_36, hal_dvs)
allow platform_app_36 hal_dms_hwservice:hwservice_manager find;
binder_call(hal_dms_default, platform_app_36)

# DaxService looks for an AIDL DMS before falling back to the HIDL one we ship
dontaudit platform_app_36 default_android_service:service_manager find;

# MIUI Camera probes things it works without: the data port manager's tcm
# socket, the Soter HAL and the VPP HAL library under /vendor
dontaudit platform_app_36 vendor_dpmtcm_socket:sock_file write;
dontaudit platform_app_36 vendor_hal_soter_hwservice:hwservice_manager find;
dontaudit platform_app_36 vendor_file:file read;
