# Audio
af.fast_track_multiplier=1
audio.deep_buffer.media=true
audio.offload.min.duration.secs=30
audio.offload.video=true
ro.af.client_heap_size_kbyte=7168

# Disable RescueParty due to high risk of data loss
persist.sys.disable_rescue=true

# FUSE passthrough
persist.sys.fuse.passthrough.enable=true

# LMK tuning
# lmkd counts free swap as at most (free + inactive file) x this ratio. At the
# default 1 it saw "swap is low" with 2.6 GB of zram free and killed apps;
# zram here compresses about 3x. (swap_free_low_percentage is overridden by
# the vendor perfconfigstore, so it isn't set here.)
ro.lmk.swap_compression_ratio=3
# Only the oldest cached apps get killed just for free memory being under the
# high watermark, not the ones used a moment ago
ro.lmk.lowmem_min_oom_score=951

# Maintainer
ro.aospa.maintainer=Suvojeet Sengupta

# 5G NSA: the modem never reports EN-DC, keep NR on the cell it was seen on
ro.telephony.sticky_nr_anchor=true

# Hardware info
ro.aospa.soc_name=Qualcomm Snapdragon 778G 5G
