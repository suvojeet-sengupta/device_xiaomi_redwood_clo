# Multi-gen LRU. Only system init may write lru_gen/enabled, so this lives
# on system_ext. Kernels without MGLRU have no such file, and the writes
# just fail.
#
# 0x0001 is the core, 0x0002 lets it walk page tables for young pages.
# 0x0004 (non-leaf PMD young) needs hardware support that arm64 doesn't
# have, so core and mm_walk is all redwood can use.
on boot
    write /sys/kernel/mm/lru_gen/enabled 3

# Same knobs as AOSP's mglru_native DeviceConfig flag, to switch it at runtime
on property:persist.device_config.mglru_native.lru_gen_config=none
    write /sys/kernel/mm/lru_gen/enabled 0

on property:persist.device_config.mglru_native.lru_gen_config=core
    write /sys/kernel/mm/lru_gen/enabled 1

on property:persist.device_config.mglru_native.lru_gen_config=core_and_mm_walk
    write /sys/kernel/mm/lru_gen/enabled 3
